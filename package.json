{
    "name": "@fitt-ai/video-sdk",
    "version": "1.4.1",
    "description": "Records answers and proctoring sessions in the browser for Fitt Video.",
    "type": "module",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "https://github.com/Psych-AI/fitt-video-js-sdk.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "skill"
    ],
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "default": "./dist/npm/index.js"
        },
        "./ui": {
            "types": "./dist/types/ui.d.ts",
            "default": "./dist/npm/ui.js"
        }
    },
    "scripts": {
        "build": "vite build -c vite.hosted.config.ts && vite build -c vite.npm.config.ts && tsc -p tsconfig.build.json",
        "test": "node --test 'tests/unit/**/*.test.ts'",
        "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json",
        "test:browser": "playwright test -c playwright.config.ts",
        "test:build": "node --test 'tests/build/*.test.ts'",
        "test:contract": "npm run build && playwright test -c playwright.contract.config.ts"
    }
}
